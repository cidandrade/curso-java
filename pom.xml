<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.cidandrade</groupId>
    <artifactId>curso-java</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Curso de Java</name>
    <description>Fundamentos, POO, coleções, GUI e padrões de projeto GoF — Prof. Cid Andrade</description>
    <url>https://github.com/cidandrade/curso-java</url>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <lombok.version>1.18.48</lombok.version>
        <jfreechart.version>1.5.3</jfreechart.version>
        <mysql-connector-j.version>8.4.0</mysql-connector-j.version>
    </properties>

    <modules>
        <module>01-fundamentos/001-ola-mundo</module>
        <module>01-fundamentos/002-carro</module>
        <module>01-fundamentos/003-heranca</module>
        <module>01-fundamentos/004-interface</module>
        <module>01-fundamentos/005-variaveis</module>
        <module>01-fundamentos/006-vetores</module>
        <module>01-fundamentos/007-entrada-e-saida</module>
        <module>02-recursos-da-linguagem/008-biblioteca</module>
        <module>02-recursos-da-linguagem/009-classes-pojo</module>
        <module>02-recursos-da-linguagem/010-pojo-com-lombok</module>
        <module>02-recursos-da-linguagem/011-string</module>
        <module>02-recursos-da-linguagem/012-decisao-e-repeticao</module>
        <module>02-recursos-da-linguagem/013-aninhamento-de-classes</module>
        <module>02-recursos-da-linguagem/014-classe-aninhada-local</module>
        <module>02-recursos-da-linguagem/015-classe-aninhada-anonima</module>
        <module>02-recursos-da-linguagem/016-matematica</module>
        <module>02-recursos-da-linguagem/017-enumeracao</module>
        <module>03-colecoes-e-apis/018-baralho-com-hashset</module>
        <module>03-colecoes-e-apis/019-baralho-com-list</module>
        <module>03-colecoes-e-apis/020-menu-com-map</module>
        <module>03-colecoes-e-apis/021-datas</module>
        <module>03-colecoes-e-apis/022-lambda</module>
        <module>03-colecoes-e-apis/023-quadrado</module>
        <module>04-interface-grafica-e-integracao/024-calculadora</module>
        <module>04-interface-grafica-e-integracao/025-cep</module>
        <module>05-padroes-criacionais/026-estudio</module>
        <module>05-padroes-criacionais/027-estudio-melhorado</module>
        <module>05-padroes-criacionais/028-hamburgueria</module>
        <module>05-padroes-criacionais/029-nova-hamburgueria</module>
        <module>05-padroes-criacionais/030-jogo-de-cartas</module>
        <module>06-padroes-estruturais/031-quem-nao-tem-cao</module>
        <module>06-padroes-estruturais/032-formas-coloridas</module>
        <module>06-padroes-estruturais/033-questionario</module>
        <module>06-padroes-estruturais/034-empacotamento</module>
        <module>06-padroes-estruturais/035-cafeteria</module>
        <module>06-padroes-estruturais/036-arvore-de-natal</module>
        <module>06-padroes-estruturais/037-novo-formas-coloridas</module>
        <module>06-padroes-estruturais/038-novo-carro</module>
        <module>06-padroes-estruturais/039-cafeteria-leve</module>
        <module>06-padroes-estruturais/040-magos-e-torres</module>
        <module>07-padroes-comportamentais/041-credito</module>
        <module>07-padroes-comportamentais/042-meteorologia</module>
        <module>07-padroes-comportamentais/043-novo-meteorologia</module>
        <module>07-padroes-comportamentais/044-meteorologia-gui</module>
        <module>07-padroes-comportamentais/045-lampada</module>
        <module>07-padroes-comportamentais/046-comandos-em-arquivo</module>
        <module>07-padroes-comportamentais/047-menus-diferentes</module>
        <module>07-padroes-comportamentais/048-chat</module>
        <module>07-padroes-comportamentais/049-vida</module>
        <module>07-padroes-comportamentais/050-vida-de-gato</module>
        <module>07-padroes-comportamentais/051-caes-polimorficos</module>
        <module>07-padroes-comportamentais/052-descontos</module>
        <module>07-padroes-comportamentais/053-cha-ou-cafe</module>
        <module>07-padroes-comportamentais/054-carrinho-de-compras</module>
        <module>08-arquitetura-e-persistencia/055-mvc</module>
        <module>08-arquitetura-e-persistencia/056-livraria</module>
        <module>08-arquitetura-e-persistencia/057-grafico</module>
        <module>09-concorrencia-redes-e-io/058-thread</module>
        <module>09-concorrencia-redes-e-io/059-outra-thread</module>
        <module>09-concorrencia-redes-e-io/060-servidor-tcp</module>
        <module>09-concorrencia-redes-e-io/061-cliente-tcp</module>
        <module>09-concorrencia-redes-e-io/062-serializacao-de-objetos</module>
        <module>exercicios/E001-numeros-primos</module>
        <module>exercicios/E002-temperatura</module>
        <module>exercicios/E003-triangulo</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.cidandrade</groupId>
                <artifactId>biblioteca</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.jfree</groupId>
                <artifactId>jfreechart</artifactId>
                <version>${jfreechart.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector-j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.4</version>
                    <configuration>
                        <mainClass>${exec.mainClass}</mainClass>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
